# Install once before enabling this unit:
#   useradd --system --user-group --home-dir /var/lib/translate-book-web --shell /usr/sbin/nologin translatebook
#   install -d -m 0750 -o translatebook -g translatebook /var/lib/translate-book-web
#   install -d -m 0700 -o translatebook -g translatebook /var/lib/translate-book-web/.codex
#   install -m 0600 -o translatebook -g translatebook /root/.codex/auth.json /var/lib/translate-book-web/.codex/auth.json
#   chown -R translatebook:translatebook /root/projects/translate-book-web/data
# The current checkout lives below /root, so the service account also needs
# traversal-only access to /root: chmod o+x /root
# The Codex auth file above is runtime-only and must never be committed.

[Unit]
Description=Translate Book web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=translatebook
Group=translatebook
WorkingDirectory=/root/projects/translate-book-web
Environment=HOME=/var/lib/translate-book-web
Environment=CODEX_HOME=/var/lib/translate-book-web/.codex
Environment=PATH=/root/projects/translate-book-web/.venv:/root/.nvm/versions/node/v25.9.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=TRANSLATE_BOOK_HOST=127.0.0.1
Environment=TRANSLATE_BOOK_BASE_PATH=/translatebook
EnvironmentFile=/root/projects/translate-book-web/.env
EnvironmentFile=/root/joy-core/security/secrets/.env.virustotal
ExecStart=/root/projects/translate-book-web/.venv/bin/python -m webapp.run
Restart=always
RestartSec=5

# The app can write only its job data and private HOME/state.
ReadWritePaths=/root/projects/translate-book-web/data /var/lib/translate-book-web
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
