[Unit]
Description=Translate Book web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/projects/translate-book-web
Environment=HOME=/root
Environment=PATH=/root/projects/translate-book-web/.venv:/root/.nvm/versions/node/v25.9.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/root/projects/translate-book-web/.env
ExecStart=/root/projects/translate-book-web/.venv/bin/python -m webapp.run
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
